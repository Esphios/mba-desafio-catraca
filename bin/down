#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

project=${CAT_PROJECT:-catraca-demo}
port=${CAT_PORT:-8080}
compose=(docker compose --project-name "$project" -f "$root/compose.yaml")

command -v docker >/dev/null
docker info >/dev/null
docker compose version >/dev/null
"${compose[@]}" down --remove-orphans

if [[ -n $("${compose[@]}" ps -q 2>/dev/null) ]]; then
  echo "Containers remain for project $project." >&2
  exit 1
fi
if { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null; then
  exec 3<&-
  exec 3>&-
  echo "A listener remains on project port $port." >&2
  exit 1
fi
echo "Catraca project $project stopped; data volume preserved."
